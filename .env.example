# ---------------------------------------------------------------------------
# ShipFlow AI — environment variables
# Copy to `.env` at the repo root. pnpm/turbo load it for all packages.
# ---------------------------------------------------------------------------

# Database (PostgreSQL). DIRECT_URL is used for migrations when behind a pooler.
DATABASE_URL="postgresql://user:password@localhost:5432/shipflow?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/shipflow?schema=public"

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# BetterAuth
BETTER_AUTH_SECRET="generate-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# GitHub App (Octokit repo integration + webhooks). Create at
# github.com/settings/apps — see docs/M5-PLAN.md for permissions & URLs.
# PRIVATE_KEY: paste the .pem contents on one line with \n for newlines.
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""
# The app's slug (from its GitHub URL) — used for the install link.
NEXT_PUBLIC_GITHUB_APP_SLUG=""

# GitHub OAuth app (BetterAuth "Continue with GitHub" login)
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""

# AI (via Vercel AI SDK). Using Groq (free, no billing) for now.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=""
# Optional alternative providers (swap in packages/ai/src/model.ts):
GOOGLE_GENERATIVE_AI_API_KEY=""
ANTHROPIC_API_KEY=""

# Inngest (async workflows).
# Local dev: NOT needed — run `npx inngest-cli@latest dev` instead.
# Production: prefer the Inngest↔Vercel integration (injects these
# automatically); only set manually if not using the integration.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Razorpay (billing) — planned: M8
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
